<?xml version="1.0" encoding="utf-8"?>
<!--
    One Material 3 list item, from the library's own component.

    ListItemCardView arrived in Material 1.14.0 with M3 Expressive. Everything this row used
    to state by hand now comes from it:

      cardBackgroundColor  a selector, so the chosen row is tinted and the rest are not
      shapeAppearance      a state list, so corners answer to selection and pressing
      contentPadding       16dp leading and trailing, 10dp top and bottom
      ripple               the list item's own ripple colour

    Those paddings are worth noting: they are the same numbers that were measured off the
    design file by hand - 16 and 10 - which is a good sign that the reading was right, and a
    better reason to stop maintaining them here.

    The children carry the library's list-item styles too, so the label and supporting text
    take their typography and their state colours from Material rather than from this file,
    and the radio and switch come pre-set to non-clickable with the correct tints: the row is
    the touch target, not the control inside it.

    The Segmented style is the one the design uses - a group of rows that share a container.
    Which corner each row gets is set from code, by position; see SettingsActivity.shapeGroup.

    The radio and the switch have saveEnabled="false", and that is load-bearing rather than
    tidy. Every row on the screen is an <include> of this file, so every radio on it carries
    the id row_radio and every switch carries row_switch. View state is saved and restored by
    id, so the ids collide: one value is written for all of them, and on restore it lands on
    all of them. Resetting the settings calls recreate(), which carries that state across, and
    the restored copy arrived after onCreate had set each row from the preferences - so a reset
    left every group with nothing selected at all, including groups the reset had not touched.
    The value's home is SharedPreferences and the screen reads it on every start; there is
    nothing here worth restoring.
-->
<com.google.android.material.listitem.ListItemCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.ListItemCardView.Segmented"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:swipeEnabled="false"
    tools:shapeAppearance="@style/ShapeAppearance.Material3.MediumComponent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_row_content"
        android:orientation="horizontal">

        <!--
            minWidth against the 48dp the RadioButton style inherits from minTouchTargetSize.
            Nothing taps this: the style itself sets clickable and focusable false and the card
            behind it takes the touch, so the target buys nothing and only pushes the label
            eight dp further right than the same label on a statistics row.
        -->
        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/row_radio"
            style="@style/Widget.Material3.RadioButton.ListItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:minWidth="@dimen/list_row_leading"
            android:duplicateParentState="true"
            android:saveEnabled="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_label"
                style="@style/Widget.Material3.TextView.ListItem.LabelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                tools:text="Dungeon floor" />

            <TextView
                android:id="@+id/row_caption"
                style="@style/Widget.Material3.TextView.ListItem.SupportingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:visibility="gone"
                tools:text="Changes with the difficulty"
                tools:visibility="visible" />

            <!-- Anything the row carries beyond its text: the colour swatches live in theirs. -->
            <FrameLayout
                android:id="@+id/row_extra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/row_switch"
            style="@style/Widget.Material3.Switch.ListItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:saveEnabled="false"
            android:visibility="gone"
            app:trackTint="@color/switch_track" />

        <!--
            A row that only points somewhere: the library's own trailing icon. An ImageView
            with the list item's tint selector, no background of its own, and outside the
            accessibility tree because the row is the target, not this.

            It replaced a filled tonal icon button, which drew a circle nobody asked for and
            sat off the text baseline: a MaterialButton carries its own insets and minimum
            width, so it cannot simply be placed where an icon goes.
        -->
        <ImageView
            android:id="@+id/row_icon"
            style="@style/Widget.Material3.ImageView.ListItem.TrailingIcon"
            android:contentDescription="@null"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:duplicateParentState="true"
            android:visibility="gone" />

        <!--
            A row that carries its own action - deleting an imported file - needs a target of
            its own, so this one is a button. The plain icon button rather than the filled
            tonal: no container until it is touched, which is what a low-priority action
            beside a row should look like.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/row_action"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.listitem.ListItemCardView>
