<?xml version="1.0" encoding="utf-8"?>
<!--
    The settings screen, whole, in one layout file - which is the point of it: Android Studio
    draws all of this in Split view, so it is corrected by looking rather than by installing.

    Every control is the Material component for the job, taken from the library rather than
    reproduced. What each one brings, checked against material 1.14.0 rather than assumed:

      ListItemCardView.Segmented        rows: background selector, shape state list,
                                        16/10 content padding, list-item ripple
      MaterialButtonGroup.Connected     the segmented frame-rate control: 8dp inner corners
                                        and the connected container shape
      Button / Button.OutlinedButton    the two actions at the bottom
      RadioButton.ListItem, Switch.ListItem, IconButton.Filled.Tonal   inside the rows

    Two things have no Material component for Views and are styles of ours, marked as such in
    themes.xml: the section header and the paragraph under it. Everything else is the library's.

    Layers, bottom to top: the header, the page over it, the buttons. The header does not
    move - the page slides up over it, so the title stays where it is and is covered rather
    than carried away. There is no app bar: it held only a back arrow, which sat under the
    status bar icons, and this is the launcher activity, where back means leaving the app.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:layout_gravity="top">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/settings_header" />

        <!--
            The title is white over artwork whose brightness is not ours to control, so it
            needs something to sit on. This darkens the image rather than saying anything
            about the palette: the one colour on this screen that is not a theme role.
        -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/header_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/header_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@android:color/white"
                tools:text="Version 0.1" />

        </LinearLayout>

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="@dimen/header_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainer"
            android:orientation="vertical">

            <!-- ============================================= Visual settings -->

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_visual" />

            <TextView
                style="@style/SectionParagraph"
                android:text="@string/settings_visual_note" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/fps_group"
                style="@style/Widget.Material3.MaterialButtonGroup.Connected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:selectionRequired="true"
                app:singleSelection="true"
                tools:shapeAppearance="@style/ShapeAppearance.Material3.MediumComponent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fps_10"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fps_10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fps_15"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fps_15" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fps_20"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fps_20" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/switch_group"
                style="@style/ListGroup">

                <include android:id="@+id/row_readout" layout="@layout/list_row" />

                <include
                    android:id="@+id/row_god"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

                <include
                    android:id="@+id/row_debug"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

            </LinearLayout>

            <!-- ================================================== Background -->

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_background" />

            <!--
                A list of its own, not a fourth row in the one below: those three rows are one
                choice between three backgrounds, and this is a switch that applies to
                whichever of them won. It comes first because it holds for all three, so it is
                read before the choice rather than looking like a fourth thing to choose.
                Same section, separate list.
            -->
            <LinearLayout
                android:id="@+id/overlay_group"
                style="@style/ListGroup">

                <include android:id="@+id/row_overlay" layout="@layout/list_row" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/background_group"
                style="@style/ListGroup">

                <include android:id="@+id/row_floor" layout="@layout/list_row" />

                <include
                    android:id="@+id/row_colour"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

                <include
                    android:id="@+id/row_photo"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

            </LinearLayout>

            <!-- ===================================================== Sprites -->

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_sprites" />

            <TextView
                style="@style/SectionParagraph"
                android:text="@string/settings_wad_note" />

            <LinearLayout
                android:id="@+id/sprites_group"
                style="@style/ListGroup">

                <include android:id="@+id/row_bundled" layout="@layout/list_row" />

                <!-- Present only once a WAD has been imported; the group closes up around it. -->
                <include
                    android:id="@+id/row_wad"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/import_wad"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/settings_wad" />

            <!-- ======================================================= About -->

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_about" />

            <TextView
                style="@style/SectionParagraph"
                android:text="@string/settings_about_note" />

            <LinearLayout
                android:id="@+id/about_group"
                style="@style/ListGroup">

                <!--
                    Source first, then the licences, then the way to report a problem: what
                    this is, what it is under, and what to do when it goes wrong.
                -->
                <include android:id="@+id/row_source" layout="@layout/list_row" />

                <include
                    android:id="@+id/row_licences"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

                <include
                    android:id="@+id/row_report"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

            </LinearLayout>

            <!--
                What the hardest level was worth. Gone until the wave table has been finished
                on it, so the screen never mentions a thing that has not happened.

                An assist chip rather than a list row: a row is a control and this is a
                record, and a chip is Material's own component for a compact piece of
                information sitting beside content. It is not clickable, because there is
                nothing to open - the record is the whole of it.

                It was very nearly a tooltip. Material 3 for Views has none that is public:
                TooltipDrawable and Widget.Material3.Tooltip exist, and both are
                @RestrictedApi(LIBRARY_GROUP) - the Slider's, not an application's. A chip
                says the same thing without a gesture to discover.
            -->
            <com.google.android.material.chip.Chip
                android:id="@+id/completed"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone"
                app:chipIcon="@drawable/ic_completed"
                tools:text="Finished 2 times, first on 28 July 2026"
                tools:visibility="visible" />

            <!-- Clears the pinned buttons, which are not part of this scrolling page. -->
            <Space
                android:id="@+id/bottom_spacer"
                android:layout_width="match_parent"
                android:layout_height="176dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/button_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
            Text rather than outlined: it sits under the filled primary action, and M3 pairs a
            filled button with a text one so the two do not compete. An outline gave this the
            same visual weight as "Set as wallpaper", which is not what it is.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/set_wallpaper"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_set_wallpaper"
            tools:ignore="VisualLintButtonSize" />

    </LinearLayout>

    <!--
        The status bar scrim, and the last child so it is over everything.

        The page slides up over the fixed header, which means its text reaches y=0 and passes
        under the clock, with nothing behind the status bar in edge-to-edge to separate them.
        This is that separation. Its height is set in code from the status bar inset, because
        that is a device measurement and not a dimension we get to choose.
    -->
    <View
        android:id="@+id/status_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@drawable/status_scrim" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
