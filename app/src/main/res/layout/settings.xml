<?xml version="1.0" encoding="utf-8"?>
<!--
    The settings screen, whole, in one layout file - which is the point of it: Android Studio
    draws all of this in Split view, so it is corrected by looking rather than by installing.

    Every control is the Material component for the job, taken from the library rather than
    reproduced. What each one brings, checked against material 1.14.0 rather than assumed:

      ListItemCardView.Segmented        rows: background selector, shape state list,
                                        16/10 content padding, list-item ripple
      MaterialButtonGroup.Connected     the segmented frame-rate control: 8dp inner corners
                                        and the connected container shape
      Button / Button.OutlinedButton    the two actions at the bottom
      RadioButton.ListItem, Switch.ListItem, IconButton.Filled.Tonal   inside the rows

    Two things have no Material component for Views and are styles of ours, marked as such in
    themes.xml: the section header and the paragraph under it. Everything else is the library's.

    Layers, bottom to top: the header and its tabs, the page under them, the buttons. The
    artwork scrolls away and the tab strip comes to rest at the top, which is what an
    AppBarLayout is for - the strip used to be pinned by hand at the artwork's height, and on
    a scrolled page it hung in the middle of the screen with rows passing behind it.

    There is still no app bar in the sense that mattered: no title, no back arrow. This is the
    launcher activity, where back means leaving the app, and AppBarLayout here is a scrolling
    container rather than a bar with controls on it.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".SettingsActivity">

    <!--
        fitsSystemWindows so the strip lands *under* the status bar once the artwork has
        scrolled away. Without it the tabs collapse to y=0 and the clock sits on top of
        "Settings" - which is what the separate status scrim used to paper over, back when
        nothing up here ever moved.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:fitsSystemWindows="true"
        app:liftOnScroll="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        app:layout_scrollFlags="scroll">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/settings_header" />

        <!--
            The title is white over artwork whose brightness is not ours to control, so it
            needs something to sit on. This darkens the image rather than saying anything
            about the palette: the one colour on this screen that is not a theme role.
        -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/header_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/header_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@android:color/white"
                tools:text="Version 0.1" />

        </LinearLayout>

    </FrameLayout>

    <!--
        Three pages, one scroll view, one visible at a time.

        Not a ViewPager2: that is a dependency this app does not have and fragments this app
        does not use, for three pages that never animate between each other. The tabs swap
        which child is visible and that is the whole mechanism.

        It is the AppBarLayout's second child and carries no scroll flags, so the artwork
        above it scrolls away and the strip comes to rest at the top. Tabs you have to scroll
        back up to reach are tabs nobody uses; tabs pinned by hand halfway down the screen,
        which is what this was before, are worse.
    -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_height"
        android:theme="@style/ThemeOverlay.Tabs" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainer"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tab_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- ============================================= Visual settings -->

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_visual" />

            <TextView
                style="@style/SectionParagraph"
                android:text="@string/settings_visual_note" />

            <!--
                Each button has saveEnabled="false", for the reason list_row.xml sets out at
                length: the checked state of this group lives on its buttons, view state is
                restored after onCreate has already read the preferences, and resetting the
                settings calls recreate(), which carries that state across. Restoring a button
                here also fires the group's listener, which writes the old rate back into the
                preferences - so a reset put the frame rate back on the screen and in storage
                both. The rate's home is SharedPreferences and showFrameRate reads it on every
                start; there is nothing here worth restoring.
            -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/fps_group"
                style="@style/Widget.Material3.MaterialButtonGroup.Connected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:selectionRequired="true"
                app:singleSelection="true"
                tools:shapeAppearance="@style/ShapeAppearance.Material3.MediumComponent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fps_10"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:saveEnabled="false"
                    android:text="@string/fps_10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fps_15"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:saveEnabled="false"
                    android:text="@string/fps_15" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fps_20"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:saveEnabled="false"
                    android:text="@string/fps_20" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/switch_group"
                style="@style/ListGroup">

                <include android:id="@+id/row_readout" layout="@layout/list_row" />

                <include
                    android:id="@+id/row_god"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

                <include
                    android:id="@+id/row_debug"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

            </LinearLayout>

            <!-- ================================================== Background -->

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_background" />

            <!--
                A list of its own, not a fourth row in the one below: those three rows are one
                choice between three backgrounds, and this is a switch that applies to
                whichever of them won. It comes first because it holds for all three, so it is
                read before the choice rather than looking like a fourth thing to choose.
                Same section, separate list.
            -->
            <LinearLayout
                android:id="@+id/overlay_group"
                style="@style/ListGroup">

                <include android:id="@+id/row_overlay" layout="@layout/list_row" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/background_group"
                style="@style/ListGroup">

                <include android:id="@+id/row_floor" layout="@layout/list_row" />

                <include
                    android:id="@+id/row_colour"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

                <include
                    android:id="@+id/row_photo"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

            </LinearLayout>

            <!-- ===================================================== Sprites -->

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_sprites" />

            <TextView
                style="@style/SectionParagraph"
                android:text="@string/settings_wad_note" />

            <LinearLayout
                android:id="@+id/sprites_group"
                style="@style/ListGroup">

                <include android:id="@+id/row_bundled" layout="@layout/list_row" />

                <!-- Present only once a WAD has been imported; the group closes up around it. -->
                <include
                    android:id="@+id/row_wad"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/import_wad"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/settings_wad" />

            </LinearLayout>

            <!-- =================================================== Statistics -->

            <!--
                Built from code, not listed here: the rows are one per creature or pickup and
                only the ones that have actually happened are shown, so what this file can
                usefully hold is the headings and the empty groups to put them in.
            -->
            <LinearLayout
                android:id="@+id/tab_statistics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/record_header"
                    style="@style/SectionHeader"
                    android:text="@string/stats_record" />

                <LinearLayout
                    android:id="@+id/record_group"
                    style="@style/ListGroup" />

                <TextView
                    android:id="@+id/stats_empty"
                    style="@style/SectionParagraph"
                    android:text="@string/stats_empty"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/kills_header"
                    style="@style/SectionHeader"
                    android:text="@string/stats_kills" />

                <LinearLayout
                    android:id="@+id/kills_group"
                    style="@style/ListGroup" />

                <TextView
                    android:id="@+id/deaths_header"
                    style="@style/SectionHeader"
                    android:text="@string/stats_deaths" />

                <LinearLayout
                    android:id="@+id/deaths_group"
                    style="@style/ListGroup" />

                <TextView
                    android:id="@+id/pickups_header"
                    style="@style/SectionHeader"
                    android:text="@string/stats_pickups" />

                <LinearLayout
                    android:id="@+id/pickups_group"
                    style="@style/ListGroup" />

            </LinearLayout>

            <!-- ======================================================= About -->

            <LinearLayout
                android:id="@+id/tab_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_about" />

            <TextView
                style="@style/SectionParagraph"
                android:text="@string/settings_about_note" />

            <LinearLayout
                android:id="@+id/about_group"
                style="@style/ListGroup">

                <!--
                    Source first, then the licences, then the way to report a problem: what
                    this is, what it is under, and what to do when it goes wrong.
                -->
                <include android:id="@+id/row_source" layout="@layout/list_row" />

                <include
                    android:id="@+id/row_licences"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

                <include
                    android:id="@+id/row_report"
                    layout="@layout/list_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_row_gap" />

            </LinearLayout>

            </LinearLayout>

            <!--
                The completion record used to be an assist chip here, and it truncated.

                Chip is single-line by construction - ChipDrawable ellipsizes the label to
                whatever width it is given, and maxLines, singleLine and ellipsize are all
                overridden or ignored by the widget. "Finished 2 times, first on 28 July 2026"
                does not fit on a 360dp phone, and no attribute was going to make it.

                So the record moved to the Statistics tab, where a record is the content
                rather than something sitting beside it, and became a list row like the rest.
                The old objection to that - a row is a control and this is a record - held on
                a page made of controls. It does not hold on a page made of records.
            -->

            <!-- Clears the pinned buttons, which are not part of this scrolling page. -->
            <Space
                android:id="@+id/bottom_spacer"
                android:layout_width="match_parent"
                android:layout_height="176dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/button_bar" />

    <!--
        The status bar scrim, and the last child so it is over everything.

        The page slides up over the fixed header, which means its text reaches y=0 and passes
        under the clock, with nothing behind the status bar in edge-to-edge to separate them.
        This is that separation. Its height is set in code from the status bar inset, because
        that is a device measurement and not a dimension we get to choose.
    -->
    <View
        android:id="@+id/status_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@drawable/status_scrim" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
