<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of the statistics list: a sprite, and what it is worth counting.

    A Material 3 list item with a leading image and two lines of text. No trailing text: the
    count is the label now, because the page shows no names. Names are ours and an imported
    WAD draws somebody else's bestiary, so the picture is the only label that cannot lie -
    and a number in the trailing slot used to take the whole row when it was long, which is
    what folded the completion record into a column one letter wide.

    The card and its style are the same as every other row on the screen, so shapeGroup()
    gives these the same corners as the rest.

    The sprite carries saveEnabled="false" for the reason list_row.xml sets out at length:
    these rows are inflated repeatedly into the same parents, every copy shares these ids,
    and view state is restored by id.
-->
<com.google.android.material.listitem.ListItemCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.ListItemCardView.Segmented"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:swipeEnabled="false"
    tools:shapeAppearance="@style/ShapeAppearance.Material3.MediumComponent">

    <LinearLayout
        android:id="@+id/stat_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_row_item"
        android:orientation="horizontal">

        <!--
            fitCenter, so nothing is ever cropped: the sprite is fitted whole inside the box
            and the box is what differs between the two lists - a creature gets a larger one
            than a pickup. Both sizes and the row height are set from code, because one
            layout serves both lists.
        -->
        <ImageView
            android:id="@+id/stat_sprite"
            android:layout_width="@dimen/stat_sprite_item"
            android:layout_height="@dimen/stat_sprite_item"
            android:layout_marginEnd="16dp"
            android:saveEnabled="false"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_completed" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stat_label"
                style="@style/Widget.Material3.TextView.ListItem.LabelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="155" />

            <!--
                colorError, because this line counts the times the creature killed the
                marine: the one number on the page that is bad news, and Material 3 has a
                role that says exactly that. The legend under the heading names both.
            -->
            <TextView
                android:id="@+id/stat_caption"
                style="@style/Widget.Material3.TextView.ListItem.SupportingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.listitem.ListItemCardView>
