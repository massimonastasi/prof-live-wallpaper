<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The fixed header behind the list. Named rather than repeated, because the list's top
        padding has to be exactly this: the content starts where the header ends and slides
        over it from there.
    -->
    <dimen name="header_height">220dp</dimen>
    <!-- The tab strip. The page below it is positioned by the AppBarLayout, not by us. -->
    <dimen name="tab_height">48dp</dimen>
    <!--
        The gap between rows of a segmented list. The library gives the rows their shapes and
        their padding but not the space between them, because that belongs to the group.
    -->
    <dimen name="list_row_gap">2dp</dimen>
    <!--
        The portrait in a statistics row. 56dp because the row carries two lines of text and
        Material 3 gives that row 72dp: a 56dp picture is what fits inside it with the
        standard padding. The sprites are drawn at one scale per section - the tallest fills
        this box and the rest keep their height relative to it - so this is also what decides
        how small the smallest creature ends up.
    -->
    <dimen name="stat_sprite_size">56dp</dimen>
    <!--
        The content of a list row, inside the padding the ListItemCardView adds of its own.
        One number for all three tabs: a statistics row that is taller than a settings row is
        noise, and the sprite fits inside this without lifting it.
    -->
    <dimen name="list_row_content">44dp</dimen>
    <!--
        The slot a row's leading element sits in, so the labels line up down the page whether
        the row starts with a radio button or with a sprite. A row that starts with neither
        begins at the card's own padding, which is what Material 3 draws.
    -->
    <dimen name="list_row_leading">40dp</dimen>
</resources>
