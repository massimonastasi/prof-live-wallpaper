<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material 3, following the system's own palette. minSdk is 31, so dynamic colour is
        available on every device this runs on and there is no branch to maintain: the
        settings look like the rest of the phone instead of like a theme somebody chose.

        DayNight because forcing a light screen on someone who chose dark is the one theming
        decision users notice immediately.

        NoActionBar: the bar is a MaterialToolbar inside the layout instead.

        No preference library underneath any more. The screen is a plain layout of Material 3
        widgets, so there is one styling system rather than two arguing with each other.
    -->
    <style name="AppTheme" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar" />

    <!--
        A section header: titleSmall on colorPrimary, 56dp tall, flush with the 16dp column
        the rows below it use. Taken from the design's own Section header building block.
    -->
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!--
        The tab strip, which asks for nothing except a different surface to sit on.

        Material 3 tabs draw their own background: @drawable/m3_tabs_background is a two-layer
        list that fills the container and then lays a 1dp colorOutlineVariant divider along the
        bottom - the divider the specification shows for both the primary and the secondary
        variant. Setting android:background on the view replaces that drawable and takes the
        divider with it, which is exactly what this screen used to do.

        So the container colour is changed the way the component expects instead: the drawable
        reads ?attr/colorSurface, and this remaps that one attribute for the tab strip alone,
        to the surface the page beneath it already uses. The library keeps its background, the
        divider comes back, and nothing else in the subtree moves - the labels read
        colorOnSurface and the indicator colorPrimary, neither of which is touched here.
    -->
    <style name="ThemeOverlay.Tabs" parent="">
        <item name="colorSurface">?attr/colorSurfaceContainer</item>
    </style>

    <!-- The explanation under a section header. -->
    <style name="SectionParagraph">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!--
        A List: rows stacked with a 2dp gap. It paints nothing and clips nothing - each
        ListItemCardView carries its own background, ripple and corners, and which corner
        depends on where the row sits in the group. SettingsActivity.shapeGroup assigns that.
    -->
    <style name="ListGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
