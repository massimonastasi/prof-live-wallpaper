<?xml version="1.0" encoding="utf-8"?>
<!--
    The monochrome layer of the launcher icon: the glasses the artwork wears, reduced to one
    stroked outline.

    It cannot be the full-bleed foreground the other two layers use. Themed icons keep only
    the alpha channel and fill it with the system's own colour, so a painting that is opaque
    edge to edge arrives as a solid square. A silhouette is the only shape that survives.

    108x108 is the adaptive icon canvas; the safe zone is the middle 72, and this sits well
    inside it. Black because only the alpha is read - the colour is the launcher's to choose.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:strokeColor="#000000"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M24,42 h20 a6,6 0 0 1 6,6 v12 a6,6 0 0 1 -6,6 h-20 a6,6 0 0 1 -6,-6 v-12 a6,6 0 0 1 6,-6 z M64,42 h20 a6,6 0 0 1 6,6 v12 a6,6 0 0 1 -6,6 h-20 a6,6 0 0 1 -6,-6 v-12 a6,6 0 0 1 6,-6 z M50,48 h8" />

</vector>
