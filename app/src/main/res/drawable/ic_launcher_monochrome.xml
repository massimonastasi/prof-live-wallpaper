<?xml version="1.0" encoding="utf-8"?>
<!--
    The monochrome layer of the launcher icon: the same infinity the artwork draws, reduced
    to one stroked outline.

    It cannot be the full-bleed foreground the other two layers use. Themed icons keep only
    the alpha channel and fill it with the system's own colour, so a painting that is opaque
    edge to edge arrives as a solid square. A silhouette is the only shape that survives.

    108x108 is the adaptive icon canvas; the safe zone is the middle 72, and this sits well
    inside it. Black because only the alpha is read - the colour is the launcher's to choose.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:strokeColor="#000000"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,54 C46,66 35,71 28,65 C21,59 21,49 28,43 C35,37 46,42 54,54 C62,66 73,71 80,65 C87,59 87,49 80,43 C73,37 62,42 54,54 Z" />

</vector>
