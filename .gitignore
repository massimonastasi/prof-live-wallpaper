*.iml
.gradle/
local.properties
.idea/
build/
.DS_Store
/captures
.externalNativeBuild
.cxx
*.apk
*.aab

# WAD files stay out of the repo: freedoom2.wad is downloaded during setup (see README),
# and a user's own WADs must never end up under version control.
*.wad

# Licence texts are copied into assets at build time by the copyLicences task.
# The repository copies at the root are the source of truth.
/app/src/main/assets/LICENSE
/app/src/main/assets/NOTICE.md

# Built APKs staged for hand-installing on other devices.
/dist/

# The signing key and its password. The key itself lives outside the repository;
# neither may ever be committed. Losing them means the app can never be updated
# on a device that already has it.
keystore.properties
*.jks
*.keystore

# Working documents that stay on this machine. They are the project's own notes -
# planning, measurements, status - and were never meant to be published. Ignored so
# they cannot be committed again by accident.
/docs/STATUS.md
/docs/PLAN.md
/docs/DESIGN.md
/docs/ROADMAP.md
/docs/STORE-LISTING.md
/docs/RELEASE-*.md
/FIXES-*.md
/IDEA.md

# Assistant tooling. Session state and indexes, machine-local by nature.
/.claude/
/.serena/
